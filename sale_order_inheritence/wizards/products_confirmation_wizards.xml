<odoo>
    <record id="view_product_confirm_wizard_form" model="ir.ui.view">
        <field name="name">product.confirm.wizard.form</field>
        <field name="model">product.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Product">
                <group>
                    <field name="order_id"/>
                </group>

                <field name="product_line_ids" options="{'no_create':True, 'no_open':True}" readonly="1">
                    <list>
                        <field name="product_id"/>
                        <field name="qty"/>
                        <field name="unit_price"/>
                    </list>
                </field>
                <footer>
                    <button string="Save" type="object" name="action_save" class="btn-primary"/>
                    <button string="Close" type="object" name="action_close" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
